# ============================================================================
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Database ---
# In docker-compose this is overridden to point at the `postgres` service.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/troubleshoot
DATABASE_URL_SYNC=postgresql+psycopg://app:app@localhost:5432/troubleshoot

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- MinIO / S3 ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_LOG_BUNDLES=log-bundles
MINIO_BUCKET_KB_SOURCES=kb-sources
MINIO_BUCKET_QR_SHEETS=qr-sheets
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=600

# --- Loki ---
LOKI_URL=http://localhost:3100
LOKI_FAKE=true

# --- LLM (OpenAI via langchain-openai) ---
OPENAI_API_KEY=sk-your-key-here
TRIAGE_MODEL=gpt-4o-mini
DIAGNOSIS_MODEL=gpt-4o
POLICY_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_FAKE=true

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_HOST=http://localhost:3000

# --- Notifications (dev: console) ---
NOTIFY_PROVIDER=console   # console | msg91_smtp
MSG91_AUTH_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- Agent-key auth for heartbeat ingest (per plant, comma-separated plant_code:key pairs for dev) ---
AGENT_HEARTBEAT_KEYS=DEV-PLANT:dev-agent-key-change-me

# --- QR ---
QR_BASE_URL=http://localhost:5173/a
